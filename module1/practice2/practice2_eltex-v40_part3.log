10. Клонируем репозиторий
root@eltex-practice2-v40:~# mkdir ~/eltex_clone && cd ~/eltex_clone             
root@eltex-practice2-v40:~# git clone https://github.com/StratumUnit/eltex.git .  

11. Внесём изменения в основном каталоге, не забыв про git add/commit/push. Синхронизируем 
клон репозитория с удалённым.

root@eltex-practice2-v40:~# echo "Некоторые изменения" >> README.md 
root@eltex-practice2-v40:~/eltex# git add .
root@eltex-practice2-v40:~/eltex# git commit -m "change README"
[main 8e11ae8] change README
 1 file changed, 1 insertion(+)
root@eltex-practice2-v40:~/eltex# git push origin main

root@eltex-practice2-v40:~/eltex# cd ~/eltex_clone/
root@eltex-practice2-v40:~/eltex_clone# git fetch
root@eltex-practice2-v40:~/eltex_clone# git log origin/main
