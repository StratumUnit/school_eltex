6. Подсчитайте количество строк в файле /var/log/kern.log

root@eltex-practice2-v40:~# wc -l /var/log/kern.log | awk '{print $1}'
0

7. Отформатируйте вывод записей в /var/log/apt/history.log в следующем порядке, построчно:
Commandline: … ; Start-Date: … ; End-Date: …

root@eltex-practice2-v40:~# paste -d ';' <(grep "^Commandline:" /var/log/apt/history.log) <(grep "^Start-Date:" /var/log/apt/history.log) <(grep "^End-Date:" /var/log/apt/history.log)
