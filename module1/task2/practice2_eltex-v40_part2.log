1.Найдите все записи из лога загрузки, доступного через команду journalctl с опцией -b в первые 20 секунд  с момента загрузки, начало загрузки определить автоматически.
 
root@eltex-practice2-v40:~# startTime=$(uptime -s)
root@eltex-practice2-v40:~# endTime=$(date -u -d "$(uptime -s) UTC + 20 seconds" '+ %F %T)

root@eltex-practice2-v40:~# echo $endTime
2026-07-09 15:10:10
root@eltex-practice2-v40:~# echo $startTime
2026-07-09 15:09:50

root@eltex-practice2-v40:~# journalctl -b --since "$startTime" --until "$endTime"
WARNING: terminal is not fully functional
Press RETURN to continue 
-- No entries --

В первые 20 секунд никаких записей нет, выведем первые 20 записей

